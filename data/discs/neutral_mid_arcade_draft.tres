[resource]
resource_name = "Neutral Mid Arcade Draft"
script = ExtResource("1_profile")
profile_id = &"neutral_mid_draft"
authoring_notes = "Intent: flat releases stay straight through the opening half, then bite late. Uphill hyzers add early bank and a weighted descent.
Primary controls: phase bank 0° → 20° → 24°; 8 m/s² banked descent; +12° maximum uphill fade bias."
